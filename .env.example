# Copy this file to .env and fill it in. Nothing here is read unless the value
# is set. Secrets are examples only — generate your own.

# ----- app -------------------------------------------------------------------
APP_NAME=Jobab
ENVIRONMENT=development            # development | test | production
DEBUG=true                         # must be false in production
# The address customers and Meta reach this app on. In production, https only.
PUBLIC_BASE_URL=http://localhost:8002
# Required in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
# Every channel token and store key is encrypted with a key derived from this.
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
# Extra hostnames the app is served on, comma separated (the PUBLIC_BASE_URL host is added for you).
ALLOWED_HOSTS=
# Leave blank to turn the API docs off in production, on elsewhere.
API_DOCS_ENABLED=

# ----- database (Postgres with the pgvector extension) -----------------------
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres               # must not be a default in production
DB_NAME=sales_agent
DB_SCHEMA=sales_agent

# ----- accounts and plans ----------------------------------------------------
ALLOW_SIGNUP=true                  # set false once your shops are onboarded
ADMIN_EMAIL=                       # this account sees the platform admin screens
TRIAL_CREDITS=300                  # one credit = one AI reply
TRIAL_DAYS=14
SESSION_DAYS=14

# ----- AI provider (any OpenAI-compatible API) -------------------------------
AI_ENABLED=true                    # platform-wide off switch for AI replies
LLM_BASE_URL=                      # e.g. https://api.openai.com/v1 or a Groq/OpenRouter/local URL
LLM_API_KEY=
LLM_MODEL=                         # e.g. gpt-4o-mini, llama-3.3-70b-versatile
LLM_VISION=false                   # true only if the model accepts images
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=700
# Some providers want "max_completion_tokens" instead of "max_tokens", or reject temperature.
LLM_TOKEN_PARAM=max_tokens
LLM_TEMPERATURE=0.3

# Optional: meaning-based product search (needs pgvector, already installed).
EMBEDDING_MODEL=                   # e.g. text-embedding-3-small
EMBEDDING_BASE_URL=                # defaults to LLM_BASE_URL
EMBEDDING_API_KEY=                 # defaults to LLM_API_KEY
EMBEDDING_MAX_DISTANCE=0.7

# Optional: voice-note transcription.
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=                         # e.g. whisper-1

# ----- Meta (Messenger, Instagram, WhatsApp) ---------------------------------
# From your Meta app. The verify token is any string you choose; you enter the
# same one in the Meta webhook setup. The app secret signs every webhook.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
META_GRAPH_BASE=https://graph.facebook.com
META_IG_GRAPH_BASE=https://graph.instagram.com

# ----- behaviour -------------------------------------------------------------
REPLY_DEBOUNCE_SECONDS=2.5         # wait this long for a message burst to finish
UPLOAD_DIR=data/uploads
# Keep false in production: it blocks outbound requests to private addresses (SSRF).
ALLOW_PRIVATE_URLS=false
